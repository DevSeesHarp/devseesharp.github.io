@page "/banner"
@inject NavigationHandler NavigationHandler

<section>

    <div id="banner-container" class="container">
        <div class="banner-logo">
            <h1>EQ2 Technology</h1>
            <p>IT Consulting</p>
        </div>
        @if (NavigationMode == Mode.Links)
        {
            <div class="banner-links">
                <ul>
                    @foreach (var item in NavigationHandler.Items)
                    {
                        <li>
                            <b style="font-size: xx-large;">&#x203A;&nbsp;</b>
                            <a @onclick="item.OnClick">@item.Text</a>
                        </li>
                    }
                </ul>
            </div>
        }
        else
        {
            <div class="banner-menu">
                <button class="btn" @onclick="() => _menuVisible = !_menuVisible">
                    <h1>/</h1>
                </button>
            </div>
        }
    </div>

    <Modal @bind-IsVisible="_menuVisible">
        <div class="navigation-links">
            <ul style="list-style: none;">
                @foreach (var item in NavigationHandler.Items)
                {
                    <li>
                        <b style="font-size: xx-large;">&#x203A;&nbsp;</b>
                        <a @onclick="@(() => OnNavigate(item))">@item.Text</a>
                    </li>
                }
            </ul>
        </div>
    </Modal>

</section>

@code {
    [Parameter]
    public Mode NavigationMode { get; set; }

    protected override void OnInitialized()
    {
        var mode = NavigationMode;
    }

    bool _menuVisible;

    void OnNavigate(NavigationHandler.NavigationLinks item)
    {
        item.OnClick.Invoke();
        _menuVisible = false;
        StateHasChanged();
    }

    public enum Mode
    {
        Links,
        Menu,
    }
}
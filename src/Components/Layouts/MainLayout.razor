@inherits LayoutComponentBase
<div class="page">
    <main>
        <div class="navigation">
            <div>
                <h1>EQ2 Technology</h1>
            </div>
            <button class="btn" @onclick="() => MenuVisible = !MenuVisible">
                <h1>Q</h1>
            </button>
            <Modal @bind-IsVisible="MenuVisible">
                <div class="navigation-links">
                    <ul>
                        <li>
                            <b style="font-size: xx-large;">&#x203A;&nbsp;</b>
                            <a href="/solutions">/solutions</a>
                        </li>
                        <li>
                            <b style="font-size: xx-large;">&#x203A;&nbsp;</b>
                            <a href="/consulting">/consulting</a>
                        </li>
                        <li>
                            <b style="font-size: xx-large;">&#x203A;&nbsp;</b>
                            <a href="/about">/about</a>
                        </li>
                        <li>
                            <b style="font-size: xx-large;">&#x203A;&nbsp;</b>
                            <a href="/giving-back">/giving_back</a>
                        </li>
                    </ul>
                </div>
            </Modal>
        </div>
        <article class="content">
            @Body
        </article>

        <div class="bottom-row">
            <h2 id="contact-text">Contact</h2>
            <ul id="contact">
                <li>> <a href="mailto:info@eq2.se">info@eq2.se</a></li>
                <li>> <a href="mailto:career@eq2.se">career@eq2.se</a></li>
            </ul>
        </div>
    </main>
</div>
@code
{
    public bool MenuVisible { get; set; }
}
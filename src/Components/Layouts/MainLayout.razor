@inherits LayoutComponentBase
@inject NavigationHandler NavigationHandler

<div class="page">
    <main>
        <Banner NavigationMode="BannerMode" />
        <article class="content">
            @Body
        </article>

        <Footer />
    </main>
</div>
@code
{
    Banner.Mode BannerMode
        => NavigationHandler.IsHome
        ? Banner.Mode.Links
        : Banner.Mode.Menu; 
}
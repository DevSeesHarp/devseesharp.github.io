@inherits LayoutComponentBase
@inject NavigationManager NavigationManager

<div class="page">
    <main>
        <div class="navigation">
            <div>
                <h1 @onclick="@(() => OnNavigate("/"))">EQ2 Technology</h1>
            </div>
            <span />
            <button class="btn" @onclick="() => _menuVisible = !_menuVisible">
                <h1>Menu</h1>
            </button>
        </div>
        <article class="content">
            @Body
        </article>

        <Footer />
    </main>
</div>

<Modal @bind-IsVisible="_menuVisible">
    <div class="navigation-links">
        <ul style="list-style: none;">
            <li>
                <b style="font-size: xx-large;">&#x203A;&nbsp;</b>
                <a @onclick="@(() => OnNavigate("/solutions"))">/solutions</a>
            </li>
            <li>
                <b style="font-size: xx-large;">&#x203A;&nbsp;</b>
                <a @onclick="@(() => OnNavigate("/consulting"))">/consulting</a>
            </li>
            <li>
                <b style="font-size: xx-large;">&#x203A;&nbsp;</b>
                <a @onclick="@(() => OnNavigate("/about"))">/about</a>
            </li>
            <li>
                <b style="font-size: xx-large;">&#x203A;&nbsp;</b>
                <a @onclick="@(() => OnNavigate("/giving-back"))">/giving_back</a>
            </li>
        </ul>
    </div>
</Modal>


@code
{
    bool _menuVisible;

    void OnNavigate(string path)
    {
        NavigationManager.NavigateTo(path);
        _menuVisible = false;
        StateHasChanged();
    }
}
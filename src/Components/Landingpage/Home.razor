@page "/"
@layout LandingpageLayout

<PageTitle>EQ2</PageTitle>

<div class="landingpage">
    <div id="landing" class="container">
        <div class="landing-header">
            <h1>EQ2 Technology</h1>
            <p>IT Consulting</p>
        </div>
        <div class="landing-links">
            <ul>
                <li>
                    <b style="font-size: xx-large;">&#x203A;&nbsp;</b>
                    <a href="/solutions">/solutions</a>
                </li>
                <li>
                    <b style="font-size: xx-large;">&#x203A;&nbsp;</b>
                    <a href="/consulting">/consulting</a>
                </li>
                <li>
                    <b style="font-size: xx-large;">&#x203A;&nbsp;</b>
                    <a href="/about">/about</a>
                </li>
                <li>
                    <b style="font-size: xx-large;">&#x203A;&nbsp;</b>
                    <a href="/giving-back">/giving_back</a>
                </li>
            </ul>
        </div>
    </div><!--landing-->

    <div id="grid">
        @foreach (var item in _gridItems)
        {
            <div class="grid-item" style="@item.GetStyle()">
                <div class="grid-item-overlay">
                    <a href="@item.Hyperlink">
                        @item.Text
                    </a>
                </div>
            </div>
        }
    </div><!--grid-->
</div><!--landingpage-->

@code {
    ICollection<GridItem> _gridItems = [];

    protected override void OnInitialized()
    {
        _gridItems = [
            new("Solutions", "/solutions", "/images/eq2-datacenter.jpg"),
            new("We are", "/solutions", "/images/eq2-field.jpg"),
            new("Consultants", "/solutions", "/images/eq2-consulting.jpg"),
            new("People", "/about", "/images/eq2-field.jpg"),
            new("Giving back", "/solutions", "/images/eq2-datacenter.jpg"),
            new("Solutions", "/solutions", "/images/eq2-datacenter.jpg"),
            new("We are", "/solutions", "/images/eq2-field.jpg"),
            new("Consultants", "/solutions", "/images/eq2-consulting.jpg"),
            new("People", "/about", "/images/eq2-field.jpg"),
            new("Giving back", "/solutions", "/images/eq2-datacenter.jpg"),
            new("Solutions", "/solutions", "/images/eq2-datacenter.jpg"),
            new("We are", "/solutions", "/images/eq2-field.jpg"),
            new("Consultants", "/solutions", "/images/eq2-consulting.jpg"),
            new("People", "/about", "/images/eq2-field.jpg"),
            new("Giving back", "/solutions", "/images/eq2-datacenter.jpg"),
        ];
    }

    record GridItem(string Text, string Hyperlink, string BackgroundPath)
    {
        public string GetStyle() => $"background: url({BackgroundPath}) center / cover no-repeat";
    }
}